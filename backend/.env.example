GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/auth/github/callback

# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

ANTHROPIC_API_KEY=

OPENAI_API_KEY=

# Which provider to use: anthropic or openai
AI_PROVIDER=anthropic

# Supabase project settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# Settings -> API -> service_role. NEVER expose this to the frontend.
# Used to enforce 2FA server-side by checking enrolled MFA factors.
SUPABASE_SERVICE_ROLE_KEY=

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/repo_core
FRONTEND_URL=http://localhost:5173
BACKEND_URL=https://provisio-41sr.onrender.com

# Payment providers
FLW_SECRET_KEY=
FLW_PUBLIC_KEY=
FLW_ENCRYPTION_KEY=
FLW_WEBHOOK_SECRET=
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# Transactional email (welcome emails). Provider-agnostic: point EMAIL_API_URL
# at a transactional email API (Resend/Postmark/SendGrid/etc) and set its key.
# Left blank, welcome-email sending is a logged no-op.
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=noreply@provisio.site
